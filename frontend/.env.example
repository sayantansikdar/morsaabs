# Copy to .env.local and fill in. Everything here is optional for local dev —
# the site runs without any of it.

# Canonical origin. Drives canonical tags, the sitemap, OG URLs and JSON-LD.
# Must be the real production origin before launch or the SEO metadata is wrong.
NEXT_PUBLIC_SITE_URL=https://www.morsaabs.com

# Google Analytics 4 measurement ID (feature 19). Leave empty to disable the tag
# entirely — no script is injected when this is unset.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console verification token (feature 48). Paste the value from the
# "HTML tag" verification method — just the content, not the whole meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Datadog Real User Monitoring (browser). Both values are read from the Datadog
# app under RUM > Applications; they are shipped in the client bundle and are not
# secret — the client token is write-only intake. RUM stays off until both are
# set. In CI these come from repo Variables (Settings > Secrets and variables >
# Actions > Variables), not from this file.
NEXT_PUBLIC_DD_APPLICATION_ID=
NEXT_PUBLIC_DD_CLIENT_TOKEN=
# This account's region. Leave as-is unless the Datadog account moves regions.
NEXT_PUBLIC_DD_SITE=us5.datadoghq.com
# Optional: 'production' | 'staging' | 'development', and 0–100 sample rates.
# Session Replay records the DOM, so it defaults to 0 (off).
NEXT_PUBLIC_DD_ENV=
NEXT_PUBLIC_DD_SESSION_SAMPLE_RATE=
NEXT_PUBLIC_DD_REPLAY_SAMPLE_RATE=

# FastAPI backend for reservations/orders/contact. Server-side only, never
# exposed to the browser. Unset means submissions are accepted and logged so the
# site is deployable while the backend is being wired up.
# Local:      http://localhost:8000
# Production: https://api.morsaabs.com
BACKEND_API_URL=
