# ---------------------------------------------------------------------------
# Local development only. In AWS, SAM injects the table names and Lambda
# supplies credentials -- none of this file is used there.
# ---------------------------------------------------------------------------

# Point boto3 at dynamodb-local instead of real AWS. MUST be empty/unset in AWS.
DYNAMODB_ENDPOINT_URL=http://localhost:8001
AWS_REGION=ap-south-1

# dynamodb-local ignores these, but boto3 refuses to sign without them.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Comma-separated browser origins allowed to call the API.
# Unused in production: CloudFront serves the site and /api from one origin.
CORS_ORIGINS=http://localhost:3000

# Table name overrides (defaults shown). SAM sets these in Lambda.
# RESERVATIONS_TABLE=morsaabs-reservations
# ORDERS_TABLE=morsaabs-orders
# CONTACT_TABLE=morsaabs-contact-messages
